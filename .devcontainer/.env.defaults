# Committed defaults for the devcontainer environment, loaded by Docker
# Compose (docker-compose.yml, env_file). .devcontainer/.env (gitignored,
# optional) overrides matching keys; keys you don't set there keep the value
# from here.
#
# Neither file may hold a secret: the devcontainer CLI prints the resolved
# Compose config, values included, in its start log. Tokens go in
# .devcontainer/.env.credentials (see .env.credentials.example).
#
# CPU and memory limits are not read from here — set DEVCONTAINER_CPUS and
# DEVCONTAINER_MEMORY in .devcontainer/.env (see docker-compose.yml).
#
# Changes here or in .env take effect after "Rebuild Container".
#
# Format: KEY=value lines and whole-line # comments. Compose expands $VAR in
# values from the host environment, so no value may contain a `$`.

# Claude auth mode for post-start.sh (see README.md):
#   proxy  — copies host settings.json (API proxy config)
#   oauth  — copies host .credentials.json (claude login / OAuth tokens)
CLAUDE_AUTH=oauth

# Mail domain of the random git identity post-start.sh sets for Claude's
# commits (e.g. claus.coder@<domain>).
GIT_EMAIL_DOMAIN=chrisski.dev
